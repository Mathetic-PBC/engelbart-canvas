# Copy these settings to ~/.engelbart/sandbox.env (private, never sent to the UI).
# No E2B_API_KEY here: the app's E2B key always comes from the GitHub sign-in, and one in a file is ignored.
# Only an unpackaged build (npm start) honors E2B_API_KEY, and only from the process environment.
# Setup always runs through your local Claude Code subscription; no Anthropic API key is used.
# ENGELBART_SANDBOX_CLAUDE_MODEL=claude-sonnet-5-5
# Template built by engelbart-web/sandbox/build-template.mjs, with proxy.mjs installed.
E2B_TEMPLATE=engelbart-runner
# Optional: use an existing private env file instead of copying settings.
# ENGELBART_SANDBOX_ENV_FILE=/absolute/path/to/existing/.env.local
