# Copy these settings to ~/.engelbart/sandbox.env (private, never sent to the UI).
E2B_API_KEY=
# Optional fallback: used only if local Claude is unavailable or setup fails.
ANTHROPIC_API_KEY=
# Default auto: local Claude subscription first, then API-key setup if needed.
# Override with claude-local to prohibit API fallback, or api to use API only.
# E2B_API_KEY is required in every mode.
# ENGELBART_SANDBOX_SETUP=auto
# ENGELBART_SANDBOX_CLAUDE_MODEL=sonnet
# Template built by engelbart-web/sandbox/build-template.mjs, with hc_run.py and proxy.mjs installed.
E2B_TEMPLATE=engelbart-runner
# Optional: use an existing private env file instead of copying API keys.
# ENGELBART_SANDBOX_ENV_FILE=/absolute/path/to/existing/.env.local
