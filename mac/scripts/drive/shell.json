{
  "about": "The shell on its own (wave 1), on DemoBackend's one-project workspace: controls, Settings (pages, search, Escape order), New Window. mac/scripts/cloud-test.sh app --filter mac/scripts/drive/shell.json",
  "env": { "ENGELBART_SHELL_DEMO": "workspace" },
  "steps": [
    { "waitFor": "window-controls" },
    { "expect": "screen=workspace" },
    { "expectTitle": "Fellowship — Engelbart" },
    { "expect": "settings-gear" },
    { "expectMissing": "test-toggle" },
    { "snapshot": "workspace" },
    { "click": "settings-gear" },
    { "waitFor": "settings-dialog" },
    { "expect": "settings-page=model" },
    { "expect": "settings-page=connections" },
    { "expect": "settings-page=guided-setup" },
    { "expectMissing": "settings-page=test-data" },
    { "click": "settings-search" },
    { "type": "zot" },
    { "wait": 200 },
    { "expect": "settings-page=connections" },
    { "expectMissing": "settings-page=model" },
    { "snapshot": "settings-search" },
    { "key": "Escape" },
    { "wait": 200 },
    { "expect": "settings-page=model" },
    { "expect": "settings-dialog" },
    { "key": "Escape" },
    { "wait": 300 },
    { "expectMissing": "settings-dialog" },
    { "menu": "File/New Window" },
    { "wait": 800 },
    { "window": 1 },
    { "expect": "screen=workspace" },
    { "expectTitle": "Fellowship — Engelbart" },
    { "snapshot": "two-windows" }
  ]
}
