{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/goal-workspace/**",
              "ui_kits/setup-wizard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Code Pro))/i]",
        "message": "Font not provided by the design system. Available: Source Code Pro."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:dir|on|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<ArrowButton> doesn't accept that prop. Declared props: dir, on, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowButton'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:prev|next)$/]",
        "message": "<ArrowButton> dir must be one of 'prev' | 'next'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Attachment'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|text|onRemove|key|ref|className|style|children)$/]",
        "message": "<Attachment> doesn't accept that prop. Declared props: kind, title, text, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='Attachment'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:url|text)$/]",
        "message": "<Attachment> kind must be one of 'url' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|caps|disabled|go|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, caps, disabled, go, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|filled|link)$/]",
        "message": "<Button> variant must be one of 'outline' | 'filled' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sub|children|strong|pad|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, sub, children, strong, pad, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Command'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|said|key|ref|className|style|children)$/]",
        "message": "<Command> doesn't accept that prop. Declared props: text, said."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|multiline|rows|size|autoFocus|onKeyDown|italicPlaceholder|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: value, onChange, placeholder, multiline, rows, size, autoFocus, onKeyDown, italicPlaceholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|sm)$/]",
        "message": "<Field> size must be one of 'lg' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Inset'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|style|key|ref|className|style|children)$/]",
        "message": "<Inset> doesn't accept that prop. Declared props: label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<ListGroup> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Message'] > JSXAttribute > JSXIdentifier[name!=/^(?:who|children|key|ref|className|style|children)$/]",
        "message": "<Message> doesn't accept that prop. Declared props: who, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Message'] > JSXAttribute[name.name='who'] > Literal[value!=/^(?:them|you)$/]",
        "message": "<Message> who must be one of 'them' | 'you'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicroLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tone|rule|right|style|key|ref|className|style|children)$/]",
        "message": "<MicroLabel> doesn't accept that prop. Declared props: children, size, tone, rule, right, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicroLabel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<MicroLabel> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicroLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:faint|ghost)$/]",
        "message": "<MicroLabel> tone must be one of 'faint' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Option'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|many|label|why|onClick|boxed|size|key|ref|className|style|children)$/]",
        "message": "<Option> doesn't accept that prop. Declared props: on, many, label, why, onClick, boxed, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Option'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|sm)$/]",
        "message": "<Option> size must be one of 'lg' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pager'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|index|onSelect|key|ref|className|style|children)$/]",
        "message": "<Pager> doesn't accept that prop. Declared props: count, index, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|action|readOnly|autoFocus|onKeyDown|bold|key|ref|className|style|children)$/]",
        "message": "<PillField> doesn't accept that prop. Declared props: value, onChange, placeholder, action, readOnly, autoFocus, onKeyDown, bold."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seed'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|size|key|ref|className|style|children)$/]",
        "message": "<Seed> doesn't accept that prop. Declared props: children, onClick, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seed'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<Seed> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SliderStop'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|why|key|ref|className|style|children)$/]",
        "message": "<SliderStop> doesn't accept that prop. Declared props: label, why."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepRailStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|state|reachable|key|ref|className|style|children)$/]",
        "message": "<StepRailStep> doesn't accept that prop. Declared props: label, value, state, reachable."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepRailStep'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|now|later)$/]",
        "message": "<StepRailStep> state must be one of 'done' | 'now' | 'later'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThinkingDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|key|ref|className|style|children)$/]",
        "message": "<ThinkingDots> doesn't accept that prop. Declared props: label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='TodoRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|onChange|onDelete|placeholder|adder|onKeyDown|key|ref|className|style|children)$/]",
        "message": "<TodoRow> doesn't accept that prop. Declared props: text, onChange, onDelete, placeholder, adder, onKeyDown."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
