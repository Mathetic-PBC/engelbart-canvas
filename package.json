{
  "name": "engelbart",
  "productName": "Engelbart",
  "version": "0.1.0",
  "private": true,
  "description": "Engelbart desktop \u2014 a simulation/testing environment for the Goal Canvas: projects, goals, topics, notes, library, PDF ink, and a native terminal.",
  "main": "src/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "relaunch": "sh scripts/relaunch.sh",
    "migrate": "node scripts/migrate-structure.cjs",
    "test": "node --test test/*.test.cjs",
    "test:pty": "ELECTRON_RUN_AS_NODE=1 electron --test test/*.integration.cjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "npm run rebuild",
    "package": "npm run build && electron-packager . Engelbart --platform=darwin --arch=arm64 --out=release --app-bundle-id=dev.engelbart.desktop --asar.unpackDir='{node_modules/node-pty,node_modules/@electric-sql/pglite}' --ignore='^/(test|docs|design|release|.superpowers|.git)($|/)' --overwrite",
    "start:debug": "npm run build && electron . --remote-debugging-port=9222"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/source-code-pro": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.0",
    "electron": "44.4.1",
    "esbuild": "0.28.2"
  }
}
