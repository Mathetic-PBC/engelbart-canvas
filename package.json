{
  "name": "engelbart",
  "productName": "Engelbart",
  "version": "0.1.14",
  "private": true,
  "description": "Engelbart: plan research projects in documents, then hand the work to Claude Code and Codex.",
  "author": "Engelbart",
  "main": "src/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "relaunch": "sh scripts/relaunch.sh",
    "new-mac": "sh scripts/new-mac.sh",
    "mac-states": "node scripts/mac-states/run.cjs",
    "migrate": "node scripts/migrate-structure.cjs",
    "test": "node scripts/test.mjs",
    "test:pty": "ELECTRON_RUN_AS_NODE=1 electron --test test/*.integration.cjs",
    "sandbox:cache:build": "node scripts/build-sandbox-cache.cjs",
    "sandbox:cache:bench": "node scripts/benchmark-sandbox-cache.cjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "npm run rebuild",
    "package": "node scripts/package-mac.mjs",
    "dist:mac": "node scripts/package-mac.mjs --release",
    "upload:mac": "bash scripts/upload-release.sh",
    "fetch-git": "node scripts/fetch-git.mjs",
    "start:debug": "npm run build && electron . --remote-debugging-port=9222"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/source-code-pro": "5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "e2b": "2.49.1",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
